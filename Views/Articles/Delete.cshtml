@model MiniProjet.Models.Article

@{
    ViewData["Title"] = "Supprimer l'article";
}

<h1>Supprimer l'article</h1>

<h3>Êtes-vous sûr de vouloir supprimer cet article ?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Title)</dt>
        <dd class="col-sm-10">@Html.DisplayFor(model => model.Title)</dd>
        <dt class="col-sm-2">Catégorie</dt>
        <dd class="col-sm-10">@(Model.Category?.Name ?? "-")</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Supprimer" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Annuler</a>
    </form>
</div>
