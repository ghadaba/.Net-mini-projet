@model IEnumerable<MiniProjet.Models.Article>

@{
    ViewData["Title"] = "Articles";
}

<h1>Articles</h1>

@if (User.IsInRole(RoleNames.Admin))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Nouvel article</a>
    </p>
}

<form asp-action="Index" method="get" class="mb-3 row g-2">
    <div class="col-auto">
        <input type="text" name="search" value="@ViewData["Search"]" class="form-control" placeholder="Rechercher (titre ou description)..." style="min-width: 220px;" />
    </div>
    <div class="col-auto">
        <select name="categoryId" class="form-select" style="min-width: 180px;">
            @foreach (var c in (IEnumerable<SelectListItem>)ViewData["Categories"]!)
            {
                @if (c.Selected)
                {
                    <option value="@c.Value" selected>@c.Text</option>
                }
                else
                {
                    <option value="@c.Value">@c.Text</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Rechercher</button>
        @if (ViewData["Search"] != null || ViewData["CategoryId"] != null)
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Effacer</a>
        }
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Title)</th>
            <th>@Html.DisplayNameFor(model => model.Category)</th>
            <th>@Html.DisplayNameFor(model => model.DateCreated)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Title)</td>
                <td>@(item.Category?.Name ?? "-")</td>
                <td>@item.DateCreated.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Détails</a>
                    @if (User.IsInRole(RoleNames.Admin))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Modifier</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Supprimer</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
